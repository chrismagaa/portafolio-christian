{
  "hosting": {
    "public": "firebase-redirect",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "regex": "^/(?P<resto>.*)$",
        "destination": "https://www.christianmagana.dev/:resto",
        "type": 301
      }
    ]
  }
}
