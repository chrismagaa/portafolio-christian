---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import StoreBadge from './StoreBadge.astro';
import proyectos from '../data/proyectos.json';

const colorEstado = {
  accent: 'text-accent',
  beta: 'text-beta',
  fuerte: 'text-cream',
  muted: 'text-muted',
} as const;

/*
  Capturas: basta con dejar una imagen en src/assets/proyectos/ con el nombre
  del proyecto en minúsculas, sin acentos y con guiones (colorigual.png,
  fisiovia.png, carta-de-recomendacion.png…). Puede ser vertical (ficha de
  tienda, va al lado) u horizontal (portada de una web, va más ancha). El
  texto alternativo sale de "capturaAlt" en proyectos.json. Si no hay
  imagen, la pantalla se compone sin ella; no queda ningún hueco.

  Collage: si hay varias imágenes numeradas (carta-de-recomendacion-1.png,
  -2, -3), se superponen como recortes pegados en la plana. La 1 es la base;
  las siguientes van encima. Sus textos alternativos van en "capturasAlt".
  Con "carrusel": true en el proyecto, esas mismas imágenes se muestran como
  carrusel con profundidad (la activa al frente, las de los lados atrás).
*/
const archivos = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/proyectos/*.{png,jpg,jpeg,webp}',
  { eager: true },
);

const slug = (texto: string) =>
  texto.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().trim().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');

const nombreArchivo = (ruta: string) => ruta.split('/').pop()?.replace(/\.[^.]+$/, '') ?? '';

const captura = (titulo: string) =>
  Object.entries(archivos).find(([ruta]) => nombreArchivo(ruta) === slug(titulo))?.[1].default;

const collage = (titulo: string) =>
  Object.entries(archivos)
    .map(([ruta, m]) => ({ n: nombreArchivo(ruta).match(new RegExp(`^${slug(titulo)}-(\\d+)$`))?.[1], img: m.default }))
    .filter((x) => x.n)
    .sort((a, b) => Number(a.n) - Number(b.n))
    .map((x) => x.img);

/*
  Posición de cada recorte, en % del recuadro (cuadrado en móvil para que
  las piezas sean legibles; 25:18 desde md). Giros mínimos para que
  se lea como recortes pegados, sin sombras: los separa un borde del color
  del papel. Pensado para hasta tres piezas.
*/
const posiciones = [
  'right-0 top-0 w-[92%] rotate-[1deg] md:w-[78%]',
  'left-0 top-[44%] w-[64%] -rotate-[2deg] md:w-[50%]',
  'right-[2%] bottom-0 w-[58%] rotate-[1.5deg] md:right-[6%] md:w-[46%]',
];

---

<!-- Cada proyecto es su propia pantalla, con el contenido centrado en vertical -->
<section>
  <h2 class="sr-only">Proyectos</h2>

  {
    proyectos.map((p) => {
      const piezas = collage(p.titulo);
      const imagen = piezas.length > 1 ? undefined : captura(p.titulo);
      // Con imagen, el nombre y el texto van a la izquierda y la escena a la derecha
      const conEscena = piezas.length > 1 || Boolean(imagen);
      return (
        <article
          class:list={[
            'flex min-h-svh snap-start flex-col justify-center border-t border-rule px-6 py-16 sm:px-10 sm:py-20',
            conEscena && 'xl:grid xl:grid-cols-2 xl:content-center xl:gap-x-16',
          ]}
        >
          <!--
            El nombre va en su propia fila, a todo el ancho: una palabra larga
            (RECOMENDACIÓN) no cabe junto a una imagen y no puede partirse.
            Interlineado 1.12: un nombre largo puede partirse en dos líneas
            y el acento de la Ó (RECOMENDACIÓN) chocaría con la de arriba.
          -->
          <h3 class:list={['m-0 min-w-0 font-display text-[44px] uppercase leading-[1.12] tracking-[-0.012em] text-balance text-cream sm:text-[72px] lg:text-[104px] xl:text-[88px]', conEscena && 'xl:col-start-1 xl:row-start-1']}>
            {p.titulo}
          </h3>

          <div
            class:list={[
              'mt-8 grid grid-cols-1 items-start gap-10 lg:gap-16',
              conEscena && 'xl:contents',
            ]}
          >
            <div class:list={['flex min-w-0 flex-col gap-6', conEscena && 'xl:col-start-1 xl:row-start-2 xl:mt-8']}>
              <!-- Una línea de datos bajo el nombre; sólo lo que exista -->
              <p class="m-0 flex flex-wrap gap-x-4 gap-y-1 text-[11px] font-medium uppercase tracking-[0.14em] text-muted">
                {p.estado && <span class={colorEstado[p.tono as keyof typeof colorEstado]}>{p.estado}</span>}
                {p.stack && <span>{p.stack}</span>}
                {p.plataformas && <span>{p.plataformas}</span>}
              </p>

              {p.descripcionHtml ? (
                <p
                  set:html={p.descripcionHtml}
                  class="m-0 max-w-[60ch] text-base leading-relaxed text-body text-pretty sm:text-lg [&_a]:text-cream [&_a]:underline [&_a]:underline-offset-[3px] hover:[&_a]:text-accent"
                />
              ) : (
                <p class="m-0 max-w-[60ch] text-base leading-relaxed text-body text-pretty sm:text-lg">{p.descripcion}</p>
              )}

              {/* El resto de la historia: <details> nativo, accesible y sin JavaScript */}
              {p.masHtml && p.masHtml.length > 0 && (
                <details class="mas group -mt-3">
                  <summary class="inline-flex w-fit cursor-pointer list-none items-center gap-2 text-[11px] font-medium uppercase tracking-[0.14em] text-accent [&::-webkit-details-marker]:hidden hover:text-cream">
                    <span class="group-open:hidden">Ver más</span>
                    <span class="hidden group-open:inline">Ver menos</span>
                    <span aria-hidden="true" class="transition-transform duration-300 group-open:rotate-180">↓</span>
                  </summary>
                  <div class="mt-5 flex flex-col gap-4">
                    {p.masHtml.map((parrafo) => (
                      <p
                        set:html={parrafo}
                        class="m-0 max-w-[60ch] text-base leading-relaxed text-body text-pretty sm:text-lg [&_a]:text-cream [&_a]:underline [&_a]:underline-offset-[3px] hover:[&_a]:text-accent"
                      />
                    ))}
                  </div>
                </details>
              )}

              {p.datos && p.datos.length > 0 && (
                <div class="flex flex-wrap gap-x-10 gap-y-5">
                  {p.datos.map((d) => (
                    <div>
                      <p class="m-0 font-display text-5xl leading-none tracking-[-0.02em] text-cream sm:text-6xl">{d.valor}</p>
                      <p class="mt-2 mb-0 text-[11px] font-medium uppercase tracking-[0.14em] text-muted">{d.etiqueta}</p>
                    </div>
                  ))}
                </div>
              )}

              {p.enlaces.length > 0 && (
                <div class="flex flex-wrap gap-2">
                  {p.enlaces.map((e) => (
                    <StoreBadge tienda={e.tipo as 'googlePlay' | 'appStore' | 'web'} url={e.url} proyecto={p.titulo} />
                  ))}
                </div>
              )}
            </div>

            {/*
              Escena: la misma caja para todas las apps (alto --escena-alto, 480px
              en escritorio), alineada con lo alto del nombre. Dentro, cada tipo
              de imagen se ajusta a ella; ninguna decide su propio tamaño.
            */}
            {conEscena && (
              <div class:list={['escena xl:col-start-2 xl:row-span-2 xl:row-start-1 xl:mt-2.5', piezas.length > 1 && !p.carrusel && 'escena-collage']}>
                {piezas.length > 1 && p.carrusel && (
                  <div
                    class="carrusel h-full"
                    role="group"
                    aria-roledescription="carrusel"
                    aria-label={`Imágenes de ${p.titulo} en su ficha de tienda`}
                    tabindex="0"
                  >
                    <ul class="carrusel-pista">
                      {piezas.map((pieza, k) => (
                        <li data-pos={String(((k + 1) % piezas.length) - 1)}>
                          <Image
                            src={pieza}
                            alt={p.capturasAlt?.[k] ?? `Imagen ${k + 1} de ${p.titulo}`}
                            widths={[300, 600, pieza.width]}
                            sizes="300px"
                            class="block h-full w-auto"
                            draggable="false"
                          />
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
                {piezas.length > 1 && !p.carrusel && (
                  <div class="collage relative mx-auto" role="group" aria-label={`Imágenes de ${p.titulo} en su ficha de tienda`}>
                    {piezas.map((pieza, k) => (
                      <Image
                        src={pieza}
                        alt={p.capturasAlt?.[k] ?? `Imagen ${k + 1} de ${p.titulo}`}
                        widths={[400, 800, pieza.width]}
                        sizes="(min-width: 1024px) 45vw, 80vw"
                        class:list={['absolute block h-auto border-[6px] border-ink', posiciones[k]]}
                      />
                    ))}
                  </div>
                )}
                {imagen && (
                  <Image
                    src={imagen}
                    alt={p.capturaAlt ?? `Captura de ${p.titulo}`}
                    widths={[480, 720, 1000, imagen.width]}
                    sizes="(min-width: 1024px) 668px, 100vw"
                    class="mx-auto block h-full w-auto max-w-full object-contain object-top"
                  />
                )}
              </div>
            )}
          </div>
        </article>
      );
    })
  }
</section>

<style>
  /* Una sola altura para la imagen de todas las apps */
  .escena {
    --escena-alto: min(60svh, 480px);
    height: var(--escena-alto);
    width: 100%;
  }
  /* El collage es más ancho que alto (25:18); en móvil, cuadrado */
  .collage {
    height: 100%;
    width: min(100%, calc(var(--escena-alto) * 25 / 18));
  }
  @media (max-width: 767px) {
    .escena-collage {
      height: auto;
    }
    .collage {
      height: auto;
      width: 100%;
      aspect-ratio: 1;
    }
  }
  .carrusel {
    outline-offset: 6px;
  }
  .carrusel-pista {
    position: relative;
    margin: 0;
    padding: 0;
    list-style: none;
    height: 100%;
    perspective: 1100px;
    overflow: hidden;
    touch-action: pan-y;
    cursor: grab;
  }
  .carrusel-pista li {
    position: absolute;
    top: 0;
    left: 50%;
    height: 100%;
    aspect-ratio: 9 / 16;
    transform-origin: center;
    transition:
      transform 0.6s cubic-bezier(0.22, 1, 0.36, 1),
      filter 0.6s ease;
    user-select: none;
  }
  .carrusel-pista li[data-pos='0'] {
    z-index: 3;
    transform: translateX(-50%) translateZ(0);
  }
  .carrusel-pista li[data-pos='-1'],
  .carrusel-pista li[data-pos='1'] {
    z-index: 1;
    filter: brightness(0.5);
    cursor: pointer;
  }
  .carrusel-pista li[data-pos='-1'] {
    transform: translateX(-132%) translateZ(-180px) rotateY(34deg);
  }
  .carrusel-pista li[data-pos='1'] {
    transform: translateX(32%) translateZ(-180px) rotateY(-34deg);
  }
  @media (prefers-reduced-motion: reduce) {
    .carrusel-pista li {
      transition: none;
    }
  }
</style>

<script>
  // Carrusel con profundidad: reparte data-pos (-1, 0, 1) de forma cíclica
  document.querySelectorAll<HTMLElement>('.carrusel').forEach((el) => {
    const items = [...el.querySelectorAll<HTMLElement>('li')];
    const n = items.length;
    let a = 0;

    const pintar = () => {
      items.forEach((li, i) => {
        li.dataset.pos = String(((i - a + n + 1) % n) - 1);
      });
    };
    const ir = (d: number) => {
      a = (a + d + n) % n;
      pintar();
    };

    items.forEach((li) =>
      li.addEventListener('click', () => {
        if (li.dataset.pos !== '0') ir(Number(li.dataset.pos));
      }),
    );
    el.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') ir(-1);
      if (e.key === 'ArrowRight') ir(1);
    });

    // Deslizar con el dedo o el ratón
    let x0: number | null = null;
    el.addEventListener('pointerdown', (e) => (x0 = e.clientX));
    el.addEventListener('pointerup', (e) => {
      if (x0 !== null && Math.abs(e.clientX - x0) > 40) ir(e.clientX < x0 ? 1 : -1);
      x0 = null;
    });
    el.addEventListener('pointercancel', () => (x0 = null));

    pintar();
  });
</script>
