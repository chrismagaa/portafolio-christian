---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import StoreBadge from './StoreBadge.astro';
import proyectos from '../data/proyectos.json';

const colorEstado = {
  accent: 'text-accent',
  beta: 'text-beta',
  fuerte: 'text-cream',
  muted: 'text-muted',
} as const;

/*
  Capturas: basta con dejar una imagen en src/assets/proyectos/ con el nombre
  del proyecto en minúsculas, sin acentos y con guiones (colorigual.png,
  fisiovia.png, carta-de-recomendacion.png…). Puede ser vertical (ficha de
  tienda, va al lado) u horizontal (portada de una web, va más ancha). El
  texto alternativo sale de "capturaAlt" en proyectos.json. Si no hay
  imagen, la pantalla se compone sin ella; no queda ningún hueco.

  Collage: si hay varias imágenes numeradas (carta-de-recomendacion-1.png,
  -2, -3), se superponen como recortes pegados en la plana. La 1 es la base;
  las siguientes van encima. Sus textos alternativos van en "capturasAlt".
*/
const archivos = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/proyectos/*.{png,jpg,jpeg,webp}',
  { eager: true },
);

const slug = (texto: string) =>
  texto.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().trim().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');

const nombreArchivo = (ruta: string) => ruta.split('/').pop()?.replace(/\.[^.]+$/, '') ?? '';

const captura = (titulo: string) =>
  Object.entries(archivos).find(([ruta]) => nombreArchivo(ruta) === slug(titulo))?.[1].default;

const collage = (titulo: string) =>
  Object.entries(archivos)
    .map(([ruta, m]) => ({ n: nombreArchivo(ruta).match(new RegExp(`^${slug(titulo)}-(\\d+)$`))?.[1], img: m.default }))
    .filter((x) => x.n)
    .sort((a, b) => Number(a.n) - Number(b.n))
    .map((x) => x.img);

/*
  Posición de cada recorte, en % del recuadro (cuadrado en móvil para que
  las piezas sean legibles; 25:18 desde md). Giros mínimos para que
  se lea como recortes pegados, sin sombras: los separa un borde del color
  del papel. Pensado para hasta tres piezas.
*/
const posiciones = [
  'right-0 top-0 w-[92%] rotate-[1deg] md:w-[78%]',
  'left-0 top-[44%] w-[64%] -rotate-[2deg] md:w-[50%]',
  'right-[2%] bottom-0 w-[58%] rotate-[1.5deg] md:right-[6%] md:w-[46%]',
];

const total = String(proyectos.length).padStart(2, '0');
---

<!-- Cada proyecto es su propia pantalla, con el contenido centrado en vertical -->
<section>
  <h2 class="sr-only">Proyectos</h2>

  {
    proyectos.map((p, i) => {
      const piezas = collage(p.titulo);
      const imagen = piezas.length > 1 ? undefined : captura(p.titulo);
      // Horizontal (portada de una web, collage) o vertical (ficha de tienda)
      const horizontal = piezas.length > 1 || (imagen ? imagen.width > imagen.height : false);
      return (
        <article class="flex min-h-svh snap-start flex-col justify-center border-t border-rule px-6 py-16 sm:px-10 sm:py-20">
          <!--
            El nombre va en su propia fila, a todo el ancho: una palabra larga
            (RECOMENDACIÓN) no cabe junto a una imagen y no puede partirse.
            El número va en la línea del nombre, no encima: el nombre es el titular.
          -->
          <div class="flex items-baseline gap-4 sm:gap-6">
            <span class="shrink-0 font-display text-xl text-ghost sm:text-2xl">
              {String(i + 1).padStart(2, '0')}<span class="text-ghost/60">/{total}</span>
            </span>
            <!--
              Interlineado 1.12: un nombre largo puede partirse en dos líneas
              y el acento de la Ó (RECOMENDACIÓN) chocaría con la de arriba.
            -->
            <h3 class="m-0 min-w-0 font-display text-[44px] uppercase leading-[1.12] tracking-[-0.012em] text-balance text-cream sm:text-[72px] lg:text-[104px]">
              {p.titulo}
            </h3>
          </div>

          <div
            class:list={[
              'mt-8 grid grid-cols-1 items-start gap-10 lg:gap-16',
              imagen && !horizontal && 'md:grid-cols-[minmax(0,1fr)_auto]',
              horizontal && 'lg:grid-cols-[minmax(0,1fr)_minmax(0,1.4fr)]',
            ]}
          >
            <div class="flex min-w-0 flex-col gap-6">
              <!-- Una línea de datos bajo el nombre; sólo lo que exista -->
              <p class="m-0 flex flex-wrap gap-x-4 gap-y-1 text-[11px] font-medium uppercase tracking-[0.14em] text-muted">
                {p.estado && <span class={colorEstado[p.tono as keyof typeof colorEstado]}>{p.estado}</span>}
                {p.stack && <span>{p.stack}</span>}
                {p.plataformas && <span>{p.plataformas}</span>}
              </p>

              {p.descripcionHtml ? (
                <p
                  set:html={p.descripcionHtml}
                  class="m-0 max-w-[60ch] text-base leading-relaxed text-body text-pretty sm:text-lg [&_a]:text-cream [&_a]:underline [&_a]:underline-offset-[3px] hover:[&_a]:text-accent"
                />
              ) : (
                <p class="m-0 max-w-[60ch] text-base leading-relaxed text-body text-pretty sm:text-lg">{p.descripcion}</p>
              )}

              {p.datos && p.datos.length > 0 && (
                <div class="flex flex-wrap gap-x-10 gap-y-5">
                  {p.datos.map((d) => (
                    <div>
                      <p class="m-0 font-display text-5xl leading-none tracking-[-0.02em] text-cream sm:text-6xl">{d.valor}</p>
                      <p class="mt-2 mb-0 text-[11px] font-medium uppercase tracking-[0.14em] text-muted">{d.etiqueta}</p>
                    </div>
                  ))}
                </div>
              )}

              {p.enlaces.length > 0 && (
                <div class="flex flex-wrap gap-2">
                  {p.enlaces.map((e) => (
                    <StoreBadge tienda={e.tipo as 'googlePlay' | 'appStore' | 'web'} url={e.url} proyecto={p.titulo} />
                  ))}
                </div>
              )}
            </div>

            {/* Plana, sin marco ni sombra; nunca más alta que la pantalla */}
            {piezas.length > 1 && (
              <div class="relative aspect-square w-full md:aspect-[25/18]" role="group" aria-label={`Imágenes de ${p.titulo} en su ficha de tienda`}>
                {piezas.map((pieza, k) => (
                  <Image
                    src={pieza}
                    alt={p.capturasAlt?.[k] ?? `Imagen ${k + 1} de ${p.titulo}`}
                    widths={[400, 800, pieza.width]}
                    sizes="(min-width: 1024px) 45vw, 80vw"
                    class:list={['absolute block h-auto border-[6px] border-ink', posiciones[k]]}
                  />
                ))}
              </div>
            )}
            {imagen && horizontal && (
              <Image
                src={imagen}
                alt={p.capturaAlt ?? `Captura de ${p.titulo}`}
                widths={[400, 800, 1200, imagen.width]}
                sizes="(min-width: 1024px) 58vw, 100vw"
                class="block h-auto max-h-[60svh] w-full object-contain object-left"
              />
            )}
            {imagen && !horizontal && (
              <Image
                src={imagen}
                alt={p.capturaAlt ?? `Captura de ${p.titulo}`}
                widths={[260, 360, 520, 720]}
                sizes="(min-width: 768px) 360px, 260px"
                class="block h-auto max-h-[64svh] w-auto max-w-[260px] md:max-w-[360px]"
              />
            )}
          </div>
        </article>
      );
    })
  }
</section>
