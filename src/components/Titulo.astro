---
interface Props {
  texto: string;
  nota?: string;
  class?: string;
}

const { texto, nota, class: className = '' } = Astro.props;
---

<div class={`flex items-baseline justify-between gap-4 ${className}`}>
  <h2 class="m-0 font-display text-4xl uppercase leading-none tracking-[-0.01em] text-cream sm:text-[46px]">
    {texto}
  </h2>
  {nota && <span class="text-[11px] font-medium uppercase tracking-[0.16em] text-muted">{nota}</span>}
</div>
