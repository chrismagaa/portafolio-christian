---
import tecnologias from '../data/tecnologias.json';
---

<section class="px-6 pt-6 sm:px-10">
  <h2 class="mt-0 mb-4 text-[11px] font-medium uppercase tracking-[0.16em] text-muted">Herramientas</h2>

  <p class="m-0 font-display text-[38px] uppercase leading-[1.06] tracking-[-0.01em] text-cream sm:text-[52px] lg:text-[62px]">
    {
      tecnologias.map((t, i) => (
        <>
          {i > 0 && <span class="text-ghost" aria-hidden="true"> / </span>}
          {t.nombre}
        </>
      ))
    }
  </p>
</section>
