---
import cifras from '../data/cifras.json';
---

<!-- Cierra la portada: filete arriba; el de abajo lo pone el primer proyecto -->
<div class="border-t border-rule">
  <!-- Tres columnas también en móvil: caben en la misma pantalla que la frase -->
  <div class="grid grid-cols-3">
    {
      cifras.map((c, i) => (
        <div
          class:list={[
            'px-4 py-6 first:pl-6 sm:px-6 sm:py-8 sm:first:pl-10 lg:px-10',
            i > 0 && 'border-l border-rule-soft',
          ]}
        >
          <p class="m-0 font-display text-[27px] leading-none tracking-[-0.02em] text-cream sm:text-[clamp(2.5rem,7vw,3.75rem)]">
            {c.valor}
          </p>
          <p class="mt-2 mb-0 text-[11px] font-medium uppercase tracking-[0.14em] text-muted">
            {c.etiqueta}
          </p>
        </div>
      ))
    }
  </div>
</div>
