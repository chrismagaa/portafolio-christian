---
import balon from '../icons/aficiones/balon.svg';
import volante from '../icons/aficiones/volante.svg';
import ejercicio from '../icons/aficiones/ejercicio.svg';
import impresion3d from '../icons/aficiones/impresion3d.svg';

const iconos = { balon, volante, ejercicio, impresion3d };

export type Aficion = keyof typeof iconos;

interface Props {
  icono: Aficion;
  /* Lado del que entra y en el que descansa el icono. */
  lado?: 'izquierda' | 'derecha';
}

const { icono, lado = 'derecha' } = Astro.props;
const Svg = iconos[icono];
---

<div
  class="adorno pointer-events-none flex h-28 items-center px-6 sm:h-40 sm:px-10"
  class:list={[lado === 'derecha' ? 'justify-end' : 'justify-start']}
  data-adorno
  data-lado={lado}
  aria-hidden="true"
>
  <Svg class="adorno-svg h-16 w-16 text-ghost sm:h-24 sm:w-24" />
</div>
