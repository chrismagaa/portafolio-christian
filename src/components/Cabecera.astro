---
import site from '../data/site.json';

const mailto = `mailto:${site.email}?Subject=${encodeURIComponent(site.asuntoEmail)}`;
---

<header
  class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2 border-b border-rule px-6 py-4 text-[11px] font-medium uppercase tracking-[0.16em] text-muted sm:px-10"
>
  <span class="text-cream">{site.nombre}</span>
  <span class="hidden sm:inline">{site.ubicacion}</span>

  <nav class="flex gap-5">
    <!-- El relleno vertical amplía el área de toque sin mover la franja -->
    <a href={site.github} target="_blank" rel="noopener" class="-my-3.5 py-3.5 transition-colors hover:text-accent">GitHub</a>
    <a href={mailto} class="-my-3.5 py-3.5 transition-colors hover:text-accent">Email</a>
  </nav>
</header>
