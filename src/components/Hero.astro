---
import site from '../data/site.json';

const mailto = `mailto:${site.email}?Subject=${encodeURIComponent(site.asuntoEmail)}`;
const [primera, segunda] = site.titular;
---

<section class="px-6 pt-12 sm:px-10 sm:pt-14">
  <!--
    Escritorio: una sola línea (`.titular` aplica white-space: nowrap desde 1024px).
    Tablet y móvil: dos líneas, separadas por el salto de abajo.
  -->
  <h1 class="titular m-0 text-cream">
    {primera}<span class="lg:hidden"><br /></span><span class="hidden lg:inline"> </span>{segunda}
  </h1>
</section>

<section
  class="grid grid-cols-1 items-start gap-8 px-6 pt-8 pb-8 sm:grid-cols-2 sm:pb-10 sm:px-10 lg:grid-cols-[repeat(3,minmax(0,1fr))_auto]"
>
  {site.bio.map((parrafo) => (
    <p class="m-0 text-sm leading-relaxed text-body text-pretty">{parrafo}</p>
  ))}

  <a
    href={mailto}
    class="justify-self-start whitespace-nowrap border-b border-cream pb-1 text-[13px] font-semibold uppercase tracking-[0.1em] text-cream transition-colors hover:border-accent hover:text-accent lg:self-end"
  >
    Contacto →
  </a>
</section>
