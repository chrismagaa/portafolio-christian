---
import Correo from './Correo.astro';
import Cifras from './Cifras.astro';
import site from '../data/site.json';
---

<!--
  Portada: ocupa exactamente la pantalla bajo la cabecera (svh, para que la
  barra del navegador móvil no la corte). La frase y la entradilla van al
  centro y la franja de cifras cierra la pantalla abajo.
  Interlineado 0.95 en el h1: el único acento en mayúscula está en la primera
  palabra («DISEÑO»), así que no hay tilde que choque con una línea de arriba.
-->
<section class="titular-marco flex min-h-[calc(100svh-var(--alto-cabecera))] flex-col">
  <div class="flex flex-1 flex-col justify-center px-6 py-12 sm:px-10 sm:py-16">
    <h1
      class="m-0 max-w-[16ch] font-display text-[44px] uppercase leading-[0.95] tracking-[-0.012em] text-balance text-cream sm:text-[72px] lg:text-[96px]"
    >
      {site.titular}
    </h1>

    <div class="mt-8 grid grid-cols-1 items-end gap-8 lg:grid-cols-[minmax(0,1fr)_auto]">
      <p class="m-0 max-w-[60ch] text-base leading-relaxed text-body text-pretty sm:text-lg">
        {site.entradilla}
      </p>
      <Correo />
    </div>
  </div>

  <Cifras />
</section>
