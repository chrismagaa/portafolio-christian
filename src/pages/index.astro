---
import Layout from '../layouts/Layout.astro';
import Cabecera from '../components/Cabecera.astro';
import Hero from '../components/Hero.astro';
import Cifras from '../components/Cifras.astro';
import Separador from '../components/Separador.astro';
import Proyectos from '../components/Proyectos.astro';
import Trayectoria from '../components/Trayectoria.astro';
import Pie from '../components/Pie.astro';
import site from '../data/site.json';
---

<Layout title={`${site.nombre} — Desarrollador Móvil`} description={site.descripcionSeo}>
  <div class="mx-auto max-w-[1400px]">
    <Cabecera />

    <main>
      <!-- Los proyectos son la portada: entrada corta y, justo debajo, las apps -->
      <Hero />
      <Proyectos />

      <Separador icono="balon" lado="derecha" />
      <Cifras />

      <Separador icono="volante" lado="izquierda" />
      <Trayectoria />

      <Separador icono="ejercicio" lado="derecha" />
    </main>

    <Pie />
  </div>
</Layout>
