---
import Layout from '../layouts/Layout.astro';
import Cabecera from '../components/Cabecera.astro';
import Hero from '../components/Hero.astro';
import Proyectos from '../components/Proyectos.astro';
import Pie from '../components/Pie.astro';
import site from '../data/site.json';
---

<Layout title={`${site.nombre} — Desarrollador Móvil`} description={site.descripcionSeo}>
  <div class="mx-auto max-w-[1400px]">
    <Cabecera />

    <!--
      Una pantalla por momento: portada (frase + cifras) y cada proyecto. En escritorio el scroll encaja suave en cada una
      (snap-proximity en la etiqueta html del layout); en móvil el scroll es libre.
    -->
    <main>
      <Hero />
      <Proyectos />
    </main>

    <Pie />
  </div>
</Layout>
