{
  "name": "portafolio-christian",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && npm run clean",
    "preview": "astro preview",
    "deploy": "npm run build && firebase deploy --only hosting --project christian-portafolio",
    "clean": "find . -name \"._*\" -not -path \"./.git/*\" -delete; find . -name .DS_Store -not -path \"./.git/*\" -delete"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.4",
    "tailwindcss": "^4.3.3"
  }
}
