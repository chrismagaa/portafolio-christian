{
  "name": "portafolio-christian",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && npm run clean",
    "preview": "astro preview",
    "clean": "find dist src public scripts design -name '._*' -delete 2>/dev/null; find dist src public scripts design -name '.DS_Store' -delete 2>/dev/null; true",
    "deploy:redirect": "firebase deploy --only hosting --project christian-portafolio"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.4",
    "tailwindcss": "^4.3.3"
  }
}
